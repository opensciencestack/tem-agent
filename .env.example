# Copy to .env and fill in. .env is gitignored; values there win over machine env vars.

# AutoScript TEM server (needed for live runs, not for --dry-run)
AUTOSCRIPT_HOST=65.1.231.167
AUTOSCRIPT_PORT=7521

# Folder holding the Thermo Fisher wheels from PythonPackages/ on the AutoScript TEM ISO.
# Read by pip from the shell, not from this file: export it before
# pip install -r requirements-autoscript.txt
AUTOSCRIPT_WHEEL_DIR=/opt/vendor/autoscript-tem/1.18.0

# Only for --model claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Only for --model gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
